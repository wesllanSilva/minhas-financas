# Copie para .streamlit/secrets.toml (local) ou cole no painel de Secrets do
# Streamlit Community Cloud. Nunca faça commit do arquivo secrets.toml.

# Postgres do Supabase/Neon. Sem isso o app usa SQLite local (dados somem no deploy).
DATABASE_URL = "postgresql://usuario:senha@host:5432/postgres?sslmode=require"

# Senha para abrir o app. Deixe em branco ou remova para não pedir senha.
app_password = "troque-esta-senha"
